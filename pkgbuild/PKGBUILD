pkgname=seqview
pkgver=0.1.0
pkgrel=1
pkgdesc='Open FASTA and FASTQ files fast, look through their sequences, and get the stats'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'xdg-desktop-portal' 'zlib')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/seqview "$pkgdir/usr/bin/seqview"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/seqview.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/seqview.svg"
  install -Dm644 "$startdir/seqview.desktop" "$pkgdir/usr/share/applications/seqview.desktop"
}
